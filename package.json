{
  "name": "ro-tools-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "playwright test",
    "build:nav": "node scripts/generate-nav-snapshot.mjs && vite build --config vite.nav.config.ts && node scripts/package-nav.mjs",
    "test:pwa": "node --test tests/unit/pwa.test.mjs",
    "check": "npm run build && npm run build:nav && npm run test:pwa && npm test",
    "publish:root": "npm run build && node scripts/publish-root.mjs",
    "prompts:nav": "node scripts/fill-nav-prompts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
